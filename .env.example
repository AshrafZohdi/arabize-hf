# Copy to a local env file and fill in. Never commit real values.

# --- Jais 3 model server (see docs/JAIS.md) ---
# API root of an OpenAI-compatible server (vLLM or SGLang) serving the model, ending in /v1.
# Leave empty to run without AI: the glossary, lessons, daily code and search still work.
JAIS_BASE_URL=
# Key the model server was started with. Leave empty if it has none.
JAIS_API_KEY=
# Model name sent in each request
JAIS_MODEL=inception42/Jais-3-375B-A23B
# Sent as chat_template_kwargs.reasoning_effort on every request. Empty leaves it to the server.
JAIS_REASONING_EFFORT=high
# Model card values: 0.7 for Arabic with thinking on, 32768 output tokens (reasoning counts towards it)
JAIS_TEMPERATURE=0.7
JAIS_MAX_TOKENS=32768
# Seconds allowed for one answer
JAIS_TIMEOUT_S=180

# --- Limits ---
# AI calls per client IP per window. 0 switches the limit off.
AI_RATE_LIMIT=60
AI_RATE_WINDOW_S=600

# --- Data and voice ---
# Hugging Face token, only to read the term bank, glossary and lessons datasets from the Hub. Never sent to the model server.
HF_TOKEN=
# "hub" loads the full term bank at startup; "off" keeps the glossary in content/ only
DARBY_TERMBANK=hub
# Storage Bucket with the pre-generated term audio, for example <org>/darby-media
HF_BUCKET=
# 1 turns on /api/tts and the listen buttons
VOICE_ENABLED=0
# 1 turns on speech to text (Whisper small on the server CPU)
ASR_ENABLED=0
# 1 mounts the glossary as MCP tools at /mcp-tools
MCP_ENABLED=1
# Signs daily code state. Set it in production so games survive a restart.
DARBY_GAME_SECRET=
