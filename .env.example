# Copy to a local env file and fill in. In the Space, set these as secrets or variables.
# Never commit real values.

# Hugging Face token with read access to the org's datasets and write access for Jobs (secret)
HF_TOKEN=
# Base URL of the Fanar 2 Inference Endpoint (llama.cpp, OpenAI compatible), for example https://xxxx.endpoints.huggingface.cloud
FANAR_ENDPOINT_URL=
# Model id sent in chat requests
FANAR_MODEL=QCRI/Fanar-2-27B-Instruct
# Storage Bucket for pre-generated audio and progress, for example <org>/darby-media
HF_BUCKET=
# 1 turns on /api/tts and the listen buttons
VOICE_ENABLED=0
# 1 serves recorded fixtures instead of calling the endpoint
DEMO_MODE=0
